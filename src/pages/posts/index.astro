---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { formatDate } from "../../lib/sources";
import { withBase } from "../../lib/paths";

const articles = (await getCollection("articles")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---
<BaseLayout title="全部文章">
  <h1 class="page-title">全部文章</h1>
  <p class="excerpt" style="margin-bottom: 1.5rem;">共 {articles.length} 篇索引。</p>
  <ul class="article-list">
    {articles.map((a) => (
      <li>
        <a class="title" href={withBase(`posts/${a.id}/`)}>{a.data.title}</a>
        <div class="meta">
          <span>{a.data.source}</span>
          <span>{formatDate(a.data.date)}</span>
        </div>
        {a.data.summary && <p class="excerpt">{a.data.summary}</p>}
      </li>
    ))}
  </ul>
</BaseLayout>
