---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { formatDate } from "../lib/sources";
import { withBase } from "../lib/paths";

const digests = (await getCollection("digests")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const latest = digests[0];
---
<BaseLayout title="页面不存在" description="页面不存在，回到 D-Ai-ly 首页或查看最新速报。">
  <section class="hero not-found">
    <p class="masthead-date">404 · 页面走丢了</p>
    <h1 class="page-title">这一页还没印出来</h1>
    <p class="excerpt lede">
      地址可能已过期或拼错了。日更内容每小时更新，旧的链接有时会被归档。
    </p>
    <div class="not-found-links">
      <a class="cta" href={withBase()}>回首页</a>
      {latest && (
        <a class="not-found-latest" href={withBase(`daily/${formatDate(latest.data.date)}/`)}>
          看 {formatDate(latest.data.date)} 的速报 →
        </a>
      )}
    </div>
  </section>
</BaseLayout>
