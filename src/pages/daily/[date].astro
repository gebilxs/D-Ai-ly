---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  FEATURED_SOURCE,
  FEATURED_SOURCE_ID,
  formatDate,
  sortSourceIds,
} from "../../lib/sources";
import { withBase } from "../../lib/paths";

export async function getStaticPaths() {
  const digests = (await getCollection("digests")).sort(
    (a, b) => a.data.date.valueOf() - b.data.date.valueOf(),
  );
  return digests.map((d, i) => ({
    params: { date: formatDate(d.data.date) },
    props: {
      digest: d,
      prev: digests[i - 1] ? formatDate(digests[i - 1].data.date) : null,
      next: digests[i + 1] ? formatDate(digests[i + 1].data.date) : null,
    },
  }));
}

const { digest, prev, next } = Astro.props;
const bySource = new Map<string, typeof digest.data.items>();
for (const item of digest.data.items) {
  const list = bySource.get(item.source_id) ?? [];
  list.push(item);
  bySource.set(item.source_id, list);
}

// Always surface 机器之心 first, even when empty for the day.
if (!bySource.has(FEATURED_SOURCE_ID)) {
  bySource.set(FEATURED_SOURCE_ID, []);
}
const orderedIds = sortSourceIds([...bySource.keys()]);
---
<BaseLayout title={digest.data.title} description={`${formatDate(digest.data.date)} 的 AI 资讯速报，共 ${digest.data.count} 条。`}>
  <article>
    <h1 class="page-title">{digest.data.title}</h1>
    <div class="meta">
      <span>{formatDate(digest.data.date)}</span>
      <span class="pill">{digest.data.count} 条</span>
    </div>

    {orderedIds.map((sourceId) => {
      const items = bySource.get(sourceId) ?? [];
      const isFeatured = sourceId === FEATURED_SOURCE_ID;
      return (
        <section class:list={["source-group", { "source-group-featured": isFeatured }]}>
          {isFeatured && (
            <div class="featured-source-links" style="margin: 0 0 1rem;">
              <a href={FEATURED_SOURCE.url} target="_blank" rel="noopener noreferrer">官网</a>
              {FEATURED_SOURCE.jumpUrl && FEATURED_SOURCE.jumpLabel && (
                <a href={withBase(`jump/${FEATURED_SOURCE.id}/`)}>{FEATURED_SOURCE.jumpLabel}</a>
              )}
            </div>
          )}
          {items.length === 0 ? (
            isFeatured ? <p class="excerpt">今日暂未收录。</p> : null
          ) : (
            <ul>
              {items.map((item) => (
                <li>
                  <a class="title" href={withBase(`posts/${item.slug}/`)}>{item.title}</a>
                  {item.summary && <p class="excerpt">{item.summary}</p>}
                  <div class="meta">
                    <a href={item.url} target="_blank" rel="noopener noreferrer">原文链接</a>
                  </div>
                </li>
              ))}
            </ul>
          )}
        </section>
      );
    })}
  </article>
  <nav class="digest-nav" aria-label="日更导航">
    {prev ? (
      <a class="digest-nav-prev" href={withBase(`daily/${prev}/`)}>← 前一天</a>
    ) : (
      <span class="digest-nav-edge">已是最早一期</span>
    )}
    {next ? (
      <a class="digest-nav-next" href={withBase(`daily/${next}/`)}>后一天 →</a>
    ) : (
      <span class="digest-nav-edge">已是最新一期</span>
    )}
  </nav>
</BaseLayout>
