---
import { SOURCES } from "../../lib/sources";

export async function getStaticPaths() {
  return SOURCES.filter((s) => s.jumpUrl).map((s) => ({
    params: { id: s.id },
    props: { source: s },
  }));
}

const { source } = Astro.props;
const target = source.jumpUrl!;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <link rel="canonical" href={target} />
    <title>跳转 · {source.name}</title>
    <script is:inline define:vars={{ target }}>
      location.replace(target);
    </script>
    <style>
      body {
        font-family: "Noto Sans SC", system-ui, sans-serif;
        max-width: 36rem;
        margin: 4rem auto;
        padding: 0 1.25rem;
        line-height: 1.6;
        color: #1a1a1a;
      }
      a { color: #0b5fff; }
    </style>
  </head>
  <body>
    <p>
      {source.name}官网（{source.url}）当前为数据服务墙，正在{source.jumpLabel}…
    </p>
    <p>
      若未自动跳转，请点击：
      <a href={target} rel="noopener noreferrer">{target}</a>
    </p>
  </body>
</html>
