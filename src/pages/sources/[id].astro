---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { formatDate, SOURCES, sourceName } from "../../lib/sources";
import { withBase } from "../../lib/paths";

export async function getStaticPaths() {
  return SOURCES.map((s) => ({ params: { id: s.id } }));
}

const { id } = Astro.params;
const name = sourceName(id!);
const meta = SOURCES.find((s) => s.id === id);
const articles = (await getCollection("articles"))
  .filter((a) => a.data.source_id === id)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<BaseLayout title={name} description={`${name} 在 D-Ai-ly 的文章归档。`}>
  <h1 class="page-title">{name}</h1>
  <div class="meta" style="margin-bottom: 1.5rem;">
    <span>{articles.length} 篇</span>
    {meta && (
      meta.jumpLabel ? (
        <a href={withBase(`jump/${meta.id}/`)}>{meta.jumpLabel}</a>
      ) : (
        <a href={meta.url} target="_blank" rel="noopener noreferrer">访问官网</a>
      )
    )}
  </div>
  {articles.length === 0 ? (
    <p class="excerpt">暂无来自此源的文章。</p>
  ) : (
    <ul class="article-list">
      {articles.map((a) => (
        <li>
          <a class="title" href={withBase(`posts/${a.id}/`)}>{a.data.title}</a>
          <div class="meta">
            <span>{formatDate(a.data.date)}</span>
          </div>
          {a.data.summary && <p class="excerpt">{a.data.summary}</p>}
        </li>
      ))}
    </ul>
  )}
</BaseLayout>
