---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  FEATURED_SOURCE,
  FEATURED_SOURCE_ID,
  OTHER_SOURCES,
  formatDate,
} from "../lib/sources";
import { withBase } from "../lib/paths";

const digests = (await getCollection("digests")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const articles = (await getCollection("articles")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const latestDigests = digests.slice(0, 7);

const latestDigest = digests[0];
const featuredItems =
  latestDigest?.data.items.filter((i) => i.source_id === FEATURED_SOURCE_ID) ??
  [];
const featuredArticles = articles
  .filter((a) => a.data.source_id === FEATURED_SOURCE_ID)
  .slice(0, 5);

// masthead: content-driven date + issue number (not build time)
const issueDate = latestDigest
  ? new Intl.DateTimeFormat("zh-CN", {
      year: "numeric",
      month: "long",
      day: "numeric",
      weekday: "long",
      timeZone: "Asia/Shanghai",
    }).format(latestDigest.data.date)
  : "";
const issueNumber = digests.length;
const headline = latestDigest?.data.items[0];
---
<BaseLayout title="D-Ai-ly" description="每日中文 AI 科技资讯速报与原文索引。">
  <section class="hero masthead">
    {issueDate && (
      <p class="masthead-date">
        {issueDate} <span class="masthead-sep">·</span> 第 {issueNumber} 期
      </p>
    )}
    <h1 class="hero-brand">D-Ai-ly</h1>
    {latestDigest && headline && (
      <p class="masthead-line">
        今日收录 {latestDigest.data.count} 条，头条：
        <a href={withBase(`posts/${headline.slug}/`)}>{headline.title}</a>
      </p>
    )}
    {!latestDigest && <p class="hero-tagline">每日中文 AI 资讯速报与原文索引。</p>}
  </section>

  <section class="section">
    <div class="section-head">
      <h2>每日速报</h2>
      {latestDigest && (
        <a href={withBase(`daily/${formatDate(latestDigest.data.date)}/`)}>查看最新 →</a>
      )}
    </div>

    <div class="featured-source">
      <div class="featured-source-head">
        <h3>
          <a href={withBase(`sources/${FEATURED_SOURCE.id}/`)}>{FEATURED_SOURCE.name}</a>
        </h3>
        <div class="featured-source-links">
          <a href={FEATURED_SOURCE.url} target="_blank" rel="noopener noreferrer">官网</a>
          {FEATURED_SOURCE.jumpUrl && FEATURED_SOURCE.jumpLabel && (
            <a href={withBase(`jump/${FEATURED_SOURCE.id}/`)}>{FEATURED_SOURCE.jumpLabel}</a>
          )}
        </div>
      </div>
      {featuredItems.length > 0 ? (
        <ul class="article-list compact">
          {featuredItems.map((item) => (
            <li>
              <a class="title" href={withBase(`posts/${item.slug}/`)}>{item.title}</a>
              {item.summary && <p class="excerpt">{item.summary}</p>}
            </li>
          ))}
        </ul>
      ) : featuredArticles.length > 0 ? (
        <ul class="article-list compact">
          {featuredArticles.map((a) => (
            <li>
              <a class="title" href={withBase(`posts/${a.id}/`)}>{a.data.title}</a>
              {a.data.summary && <p class="excerpt">{a.data.summary}</p>}
            </li>
          ))}
        </ul>
      ) : (
        <p class="excerpt featured-empty">今日暂未收录机器之心（官网需登录会话）。</p>
      )}
    </div>

    {latestDigests.length === 0 ? (
      <p class="excerpt">暂无日更，请先运行爬虫或等待 Actions 更新。</p>
    ) : (
      <ul class="digest-list">
        {latestDigests.map((d) => (
          <li>
            <a class="title" href={withBase(`daily/${formatDate(d.data.date)}/`)}>
              {d.data.title}
            </a>
            <div class="meta">
              <span>{formatDate(d.data.date)}</span>
              <span class="pill">{d.data.count} 条</span>
            </div>
          </li>
        ))}
      </ul>
    )}
  </section>

  <section class="section">
    <div class="section-head">
      <h2>订阅源</h2>
      <a href={withBase("sources/")}>全部来源 →</a>
    </div>
    <p class="source-inline">
      <a class="source-inline-featured" href={withBase(`sources/${FEATURED_SOURCE.id}/`)}>
        {FEATURED_SOURCE.name}
      </a>
      {OTHER_SOURCES.map((s) => (
        <a href={withBase(`sources/${s.id}/`)}>{s.name}</a>
      ))}
    </p>
  </section>
</BaseLayout>
