---
import "../styles/global.css";
import { withBase } from "../lib/paths";
import { SOURCES } from "../lib/sources";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "中文 AI 科技资讯日更：机器之心置顶，兼收量子位、极客公园等来源。" } = Astro.props;
const pageTitle = title === "D-Ai-ly" ? "D-Ai-ly · 每日 AI 资讯" : `${title} · D-Ai-ly`;

const navItems = [
  { href: withBase(), label: "首页", key: "" },
  { href: withBase("posts/"), label: "文章", key: "posts/" },
  { href: withBase("sources/"), label: "来源", key: "sources/" },
  { href: withBase("about/"), label: "关于", key: "about/" },
];
const currentKey = Astro.url.pathname.replace(import.meta.env.BASE_URL, "");
const isCurrent = (key: string) =>
  key === "" ? currentKey === "" : currentKey.startsWith(key);
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={withBase("favicon.svg")} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+SC:wght@400;600;700&family=Noto+Serif+SC:wght@600;700&family=Source+Serif+4:opsz,wght@8..60,600;8..60,700&display=swap"
      rel="stylesheet"
    />
    <title>{pageTitle}</title>
    <link rel="canonical" href={`https://gebilxs.github.io${Astro.url.pathname}`} />
    <meta property="og:site_name" content="D-Ai-ly" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="zh_CN" />
  </head>
  <body>
    <a class="skip-link" href="#main">跳到主要内容</a>
    <div class="site-shell">
      <header class="site-header">
        <a class="brand" href={withBase()}>D-Ai-ly</a>
        <nav class="nav" aria-label="主导航">
          {navItems.map((item) => (
            <a
              href={item.href}
              aria-current={isCurrent(item.key) ? "page" : undefined}
            >
              {item.label}
            </a>
          ))}
        </nav>
      </header>
      <main id="main">
        <slot />
      </main>
      <footer class="site-footer">
        <div class="footer-row">
          <a class="footer-brand" href={withBase()}>D-Ai-ly</a>
          <nav class="footer-nav" aria-label="来源导航">
            {SOURCES.map((s) => (
              <a href={withBase(`sources/${s.id}/`)}>{s.name}</a>
            ))}
          </nav>
        </div>
        <p class="footer-note">
          只索引标题、摘要与原文链接，不转载全文 ·
          <a href="https://github.com/gebilxs/D-Ai-ly" target="_blank" rel="noopener noreferrer">GitHub</a>
        </p>
      </footer>
    </div>
  </body>
</html>
